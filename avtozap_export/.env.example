# Скопируйте этот файл в .env и впишите свои данные.
# Если .env нет, программа спросит всё сама при первом запуске и создаст файл.

# Вход в админку АвтоЗап
AVTOZAP_USERNAME=
AVTOZAP_PASSWORD=

# Ключ OpenAI — нужен только для вопросов обычными словами.
# Без него выгрузка в csv работает как обычно.
OPENAI_API_KEY=

# Необязательно: какую модель просить. Пусто — программа выберет сама.
OPENAI_MODEL=
