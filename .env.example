# Скопируйте в .env или просто экспортируйте переменную в оболочке.
# НАСТОЯЩИЙ КЛЮЧ СЮДА НЕ ЗАПИСЫВАТЬ — файл лежит в репозитории.
#
#   export OPENAI_API_KEY="sk-..."
#
# Если переменная не задана, run_test.py спросит ключ скрытым вводом.
OPENAI_API_KEY=

# Необязательно: модели по умолчанию (можно переопределить флагами CLI).
AVTOZAP_ARBITER_MODEL=gpt-4o
AVTOZAP_VISION_MODEL=gpt-4o
